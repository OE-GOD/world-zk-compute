# World ZK Compute Python SDK: environment variables read by the test suite
#
# The SDK itself reads no environment variables: RPC URLs, private keys and
# contract addresses are passed to the client constructors. Nothing loads a
# .env file automatically either; export the variables you need, or copy this
# file to .env (git-ignored) and run `set -a; . ./.env; set +a`.

# tests/test_anvil_integration.py: port for the Anvil instance the tests start
# ANVIL_PORT=8546

# tests/test_sepolia.py: skipped unless SEPOLIA_RPC_URL is set.
# TEE_VERIFIER_ADDRESS defaults to the TEEMLVerifier entry in deployments/11155111.json.
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# TEE_VERIFIER_ADDRESS=0x...deployed_tee_verifier

# tests/test_sepolia_integration.py: skipped unless both are set
# (TEE_VERIFIER_ADDRESS above is shared).
# ALCHEMY_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
